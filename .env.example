# --------------------------------------------------
# MySQL
# --------------------------------------------------

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=returns_db
MYSQL_USER=returns_user
MYSQL_PASSWORD=change_me_mysql_password


# --------------------------------------------------
# PostgreSQL / pgvector
# --------------------------------------------------

POSTGRES_DB=returns_vector_db
POSTGRES_USER=returns_vector_user
POSTGRES_PASSWORD=change_me_postgres_password


# --------------------------------------------------
# Backend database connections
# --------------------------------------------------

DATABASE_URL=mysql+pymysql://returns_user:change_me_mysql_password@localhost:3307/returns_db
VECTOR_DATABASE_URL=postgresql+psycopg://returns_vector_user:change_me_postgres_password@localhost:5433/returns_vector_db
CHECKPOINT_DATABASE_URL=postgresql://returns_vector_user:change_me_postgres_password@localhost:5433/returns_vector_db


# --------------------------------------------------
# External / local services
# --------------------------------------------------

COURIER_API_BASE_URL=http://127.0.0.1:8001


# --------------------------------------------------
# RAG / Human Review
# --------------------------------------------------

RAG_RELEVANCE_THRESHOLD=0.50
HUMAN_REVIEW_THRESHOLD=0.70


# --------------------------------------------------
# Application
# --------------------------------------------------

LOG_LEVEL=INFO
SQL_ECHO=false
FRONTEND_ORIGIN=http://localhost:5173